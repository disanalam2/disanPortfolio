# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES TEMPLATE (Vite / React)
# ==============================================================================
# In Vite, only variables prefixed with VITE_ are exposed to the browser bundle.
# Keep all secret keys, database credentials, and auth tokens strictly in the backend .env!
# ==============================================================================

# Backend API Endpoint URL
VITE_API_URL=https://api.example.com/api
